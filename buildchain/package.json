{
  "name": "buildchain",
  "description": "A drop-in buildchain for using Vite in your Craft CMS plugins or modules",
  "type": "module",
  "author": {
    "email": "info@nystudio107.com",
    "name": "nystudio107",
    "url": "https://nystudio107.com"
  },
  "dependencies": {
    "vue": "^3.2.0",
    "vue-confetti": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^15.0.0",
    "rollup-plugin-visualizer": "^5.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-recommended": "^15.0.0",
    "stylelint-config-recommended-vue": "^1.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-compression": "^0.5.0",
    "vite-plugin-externals": "^0.6.0",
    "vue-tsc": "^2.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "lint": "npm run lint:ts && npm run lint:js && npm run lint:css",
    "lint:ts": "tsc --noEmit",
    "lint:js": "eslint './src/**/*.{js,ts,vue}' --fix",
    "lint:css": "stylelint './src/**/*.{css,vue}' --fix"
  },
  "allowScripts": {
    "esbuild": true
  }
}
